{
  "name": "moodify",
  "version": "1.0.0",
  "description": "Mood-based falling emoji rain for your macOS desktop",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.rishabhnayakk.moodify",
    "productName": "Moodify",
    "mac": {
      "category": "public.app-category.entertainment",
      "target": ["dmg", "zip"]
    }
  }
}